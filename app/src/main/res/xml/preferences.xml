<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/CustomPreferenceThemeOverlay">
    <EditTextPreference
        android:key="server_ip"
        android:title="Server IP Address"
        android:summary="Enter the server IP address"
        android:defaultValue="192.168.1.1"
        android:inputType="text" />

    <EditTextPreference
        android:key="server_port"
        android:title="Server Port"
        android:summary="Enter the server port"
        android:defaultValue="8080"
        android:inputType="number" />

<!--    <SwitchPreferenceCompat-->
<!--        android:key="is_settings_enabled"-->
<!--        android:title="Settings are enabled"-->
<!--        android:summary="Turn it off to dismiss settings from the menu"-->
<!--        android:defaultValue="false"-->
<!--        />-->

    <!-- OpenAI API key for AI Practice chat (same storage as server_ip / server_port) -->
    <EditTextPreference
        android:key="openai_api_key"
        android:title="@string/pref_openai_api_key_title"
        android:summary="@string/pref_openai_api_key_summary"
        android:defaultValue=""
        android:inputType="textPassword"
        android:singleLine="true" />

</PreferenceScreen>
